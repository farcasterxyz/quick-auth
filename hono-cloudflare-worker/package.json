    "viem": "^2.29.0",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@types/node": "^22.15.15",
    "@vitest/coverage-v8": "4.1.12",
    "ts-node": "^10.9.2",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
